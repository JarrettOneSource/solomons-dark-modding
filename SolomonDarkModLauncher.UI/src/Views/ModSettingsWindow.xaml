<Window x:Class="SolomonDarkModLauncher.UI.Views.ModSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolomonDarkModLauncher.UI.ViewModels.ModSettings"
        Title="Mod Settings · Solomon Dark Revived"
        Width="560"
        Height="660"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="HostChipStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldOutlineBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RestartChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="EntryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EntryDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="EntryErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="EntryRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionInvokeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" MinHeight="22">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource AccentBrush}"
                                                        Height="4"
                                                        CornerRadius="2,0,0,2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Height="4">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AccentBrush}"
                                                         Stroke="{StaticResource WindowBackgroundBrush}"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{StaticResource InputBackgroundBrush}"
                                                BorderBrush="{StaticResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0"
                                                  Stroke="{StaticResource TextMutedBrush}"
                                                  StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,6,26,6"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220"
                                        Margin="0,4,0,0"
                                        Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EntryHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource EntryLabelStyle}" Text="{Binding Label}" />
                <Border Style="{StaticResource HostChipStyle}"
                        Visibility="{Binding IsHostScope, Converter={x:Static vm:SettingConverters.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ChipTextStyle}"
                               Foreground="{StaticResource GoldOutlineTextBrush}"
                               Text="HOST" />
                </Border>
                <Border Style="{StaticResource RestartChipStyle}"
                        Visibility="{Binding RequiresRestart, Converter={x:Static vm:SettingConverters.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ChipTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="NEXT LAUNCH" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToggleSettingViewModel}">
            <Border Style="{StaticResource EntryRowStyle}" IsEnabled="{Binding IsReadOnly, Converter={x:Static vm:SettingConverters.Invert}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHeaderTemplate}" />
                        <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                                   Text="{Binding Description}"
                                   Visibility="{Binding HasDescription, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              IsChecked="{Binding IsOn}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NumberSettingViewModel}">
            <Border Style="{StaticResource EntryRowStyle}" IsEnabled="{Binding IsReadOnly, Converter={x:Static vm:SettingConverters.Invert}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHeaderTemplate}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding RangeText}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Style="{StaticResource DarkSliderStyle}"
                                Minimum="{Binding Min}"
                                Maximum="{Binding Max}"
                                TickFrequency="{Binding Step}"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1"
                                 Width="72"
                                 Margin="12,0,0,0"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                               Text="{Binding Description}"
                               Visibility="{Binding HasDescription, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource EntryErrorStyle}"
                               Text="{Binding ValidationError}"
                               Visibility="{Binding HasValidationError, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextSettingViewModel}">
            <Border Style="{StaticResource EntryRowStyle}" IsEnabled="{Binding IsReadOnly, Converter={x:Static vm:SettingConverters.Invert}}">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHeaderTemplate}" />
                    <Grid Margin="0,8,0,0">
                        <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Placeholder}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                               Text="{Binding Description}"
                               Visibility="{Binding HasDescription, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource EntryErrorStyle}"
                               Text="{Binding ValidationError}"
                               Visibility="{Binding HasValidationError, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChoiceSettingViewModel}">
            <Border Style="{StaticResource EntryRowStyle}" IsEnabled="{Binding IsReadOnly, Converter={x:Static vm:SettingConverters.Invert}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHeaderTemplate}" />
                        <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                                   Text="{Binding Description}"
                                   Visibility="{Binding HasDescription, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Margin="16,0,0,0"
                              MaxWidth="260"
                              VerticalAlignment="Center"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding Selected}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KeybindSettingViewModel}">
            <Border Style="{StaticResource EntryRowStyle}" IsEnabled="{Binding IsReadOnly, Converter={x:Static vm:SettingConverters.Invert}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHeaderTemplate}" />
                        <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                                   Text="{Binding Description}"
                                   Visibility="{Binding HasDescription, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                                   Text="Esc cancels · Delete clears"
                                   Visibility="{Binding IsCapturing, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  Margin="16,0,0,0"
                                  MinWidth="120"
                                  VerticalAlignment="Center"
                                  Command="{Binding ToggleCaptureCommand}"
                                  IsChecked="{Binding IsCapturing, Mode=OneWay}"
                                  Focusable="False">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Chrome"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12,6">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding DisplayText}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActionSettingViewModel}">
            <Border Style="{StaticResource EntryRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryHeaderTemplate}" />
                        <TextBlock Style="{StaticResource EntryDescriptionStyle}"
                                   Text="{Binding Description}"
                                   Visibility="{Binding HasDescription, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                        <TextBlock Visibility="{Binding HasFeedback, Converter={x:Static vm:SettingConverters.BoolToVisibility}}"
                                   Margin="0,3,0,0"
                                   FontSize="11.5"
                                   Text="{Binding Feedback}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FeedbackIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ActionInvokeButtonStyle}"
                            IsEnabled="{Binding CanInvoke}"
                            Content="{Binding Label}"
                            Click="OnActionButtonClick" />
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}"
                       Margin="0,2,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Ellipse Width="8"
                     Height="8"
                     VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Margin="8,0,0,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding LiveBadgeText}" />
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="4"
                Visibility="{Binding HasBanner, Converter={x:Static vm:SettingConverters.BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorBannerBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBannerBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="{Binding Banner}" />
        </Border>

        <ScrollViewer Grid.Row="3"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,6,10">
                            <TextBlock Text="{Binding Name}"
                                       Margin="2,0,0,7"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding HasName, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Entries}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Reset to defaults"
                    Style="{StaticResource OutlineButtonStyle}"
                    Click="OnResetClick" />

            <TextBlock Grid.Column="1"
                       Margin="14,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Text="Some changes apply on next launch"
                       Visibility="{Binding HasRestartPending, Converter={x:Static vm:SettingConverters.BoolToVisibility}}" />

            <Button Grid.Column="2"
                    Content="Close"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnCloseClick" />

            <Button Grid.Column="3"
                    Margin="10,0,0,0"
                    Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
