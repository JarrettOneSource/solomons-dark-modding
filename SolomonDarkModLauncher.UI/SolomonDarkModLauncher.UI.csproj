<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SolomonDarkModLauncher.UI</RootNamespace>
    <AssemblyName>SolomonDarkMultiplayerBeta</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DistributionLayout.cs" Link="Shared\DistributionLayout.cs" />
    <Compile Include="..\Shared\LauncherLog.cs" Link="Shared\LauncherLog.cs" />
    <Compile Include="..\Shared\LauncherPathPolicy.cs" Link="Shared\LauncherPathPolicy.cs" />
    <Compile Include="..\Shared\SemanticVersion.cs" Link="Shared\SemanticVersion.cs" />
    <Compile Include="..\Shared\UpdateProgress.cs" Link="Shared\UpdateProgress.cs" />
    <Compile Include="..\SolomonDarkModLauncher\src\ModSettings\ModSettingsModels.cs" Link="ModSettings\ModSettingsModels.cs" />
    <Compile Include="..\SolomonDarkModLauncher\src\ModSettings\ModSettingsManifestService.cs" Link="ModSettings\ModSettingsManifestService.cs" />
    <Compile Include="..\SolomonDarkModLauncher\src\ModSettings\ModSettingsDiscoveryService.cs" Link="ModSettings\ModSettingsDiscoveryService.cs" />
    <Compile Include="..\SolomonDarkModLauncher\src\ModSettings\ModSettingsStore.cs" Link="ModSettings\ModSettingsStore.cs" />
    <Compile Include="..\SolomonDarkModLauncher\src\ModSettings\ModSettingsRuntimeClient.cs" Link="ModSettings\ModSettingsRuntimeClient.cs" />
    <Compile Include="..\SolomonDarkModLauncher\src\ModSettings\ModSettingsService.cs" Link="ModSettings\ModSettingsService.cs" />
    <ProjectReference Include="..\SolomonDarkModLauncher\SolomonDarkModLauncher.csproj"
                      Condition="'$(RuntimeIdentifier)' == ''"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
</Project>
