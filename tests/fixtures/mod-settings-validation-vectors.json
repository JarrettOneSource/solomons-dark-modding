{
  "schemaVersion": 1,
  "requiredRules": [
    "settings.object",
    "settings.version",
    "settings.entries",
    "entry.schema",
    "entry.key",
    "entry.key_unique",
    "entry.type",
    "entry.label",
    "entry.description",
    "entry.group",
    "entry.scope",
    "entry.requires_restart",
    "entry.default",
    "toggle.default",
    "number.bounds",
    "number.step",
    "number.integer",
    "number.default",
    "text.max_length",
    "text.single_line",
    "text.utf8_bytes",
    "text.placeholder",
    "choice.count",
    "choice.schema",
    "choice.value",
    "choice.value_unique",
    "choice.default",
    "keybind.default",
    "action.default",
    "action.confirm"
  ],
  "vectors": [
    {
      "name": "accept_all_types_and_common_fields",
      "valid": true,
      "rules": [
        "settings.object", "settings.version", "settings.entries", "entry.schema",
        "entry.key", "entry.key_unique", "entry.type", "entry.label",
        "entry.description", "entry.group", "entry.scope",
        "entry.requires_restart", "entry.default", "toggle.default",
        "number.bounds", "number.step", "number.integer", "number.default",
        "text.max_length", "text.single_line", "text.utf8_bytes",
        "text.placeholder", "choice.count", "choice.schema", "choice.value",
        "choice.value_unique", "choice.default", "keybind.default",
        "action.default", "action.confirm"
      ],
      "manifest": {
        "id": "vector.valid",
        "settings": {
          "version": 1,
          "entries": [
            {
              "key": "toggle_1",
              "type": "toggle",
              "label": "Toggle",
              "description": "Help",
              "group": "General",
              "scope": "host",
              "requires_restart": true,
              "default": true
            },
            {
              "key": "number_1",
              "type": "number",
              "label": "Number",
              "default": 4,
              "min": 0,
              "max": 10,
              "step": 2,
              "integer": true
            },
            {
              "key": "text_1",
              "type": "text",
              "label": "Text",
              "default": "é",
              "max_length": 2,
              "placeholder": "Name"
            },
            {
              "key": "choice_1",
              "type": "choice",
              "label": "Choice",
              "default": "a",
              "choices": [
                { "value": "a", "label": "" },
                { "value": "b", "label": "B" }
              ]
            },
            {
              "key": "keybind_1",
              "type": "keybind",
              "label": "Key",
              "default": "MOUSE5"
            },
            {
              "key": "action_1",
              "type": "action",
              "label": "Action",
              "confirm": true
            }
          ]
        }
      }
    },
    {
      "name": "accept_empty_entries_and_defaults",
      "valid": true,
      "rules": ["settings.object", "settings.version", "settings.entries", "entry.scope", "entry.requires_restart"],
      "manifest": { "settings": { "version": 1, "entries": [] } }
    },
    {
      "name": "reject_settings_not_object",
      "valid": false,
      "rules": ["settings.object"],
      "manifest": { "settings": [] }
    },
    {
      "name": "reject_wrong_version",
      "valid": false,
      "rules": ["settings.version"],
      "manifest": { "settings": { "version": 2, "entries": [] } }
    },
    {
      "name": "reject_missing_entries",
      "valid": false,
      "rules": ["settings.entries"],
      "manifest": { "settings": { "version": 1 } }
    },
    {
      "name": "reject_unknown_settings_field",
      "valid": false,
      "rules": ["entry.schema"],
      "manifest": { "settings": { "version": 1, "entries": [], "future": true } }
    },
    {
      "name": "reject_unknown_entry_field",
      "valid": false,
      "rules": ["entry.schema"],
      "manifest": {
        "settings": {
          "version": 1,
          "entries": [
            { "key": "x", "type": "toggle", "label": "X", "default": true, "future": 1 }
          ]
        }
      }
    },
    {
      "name": "reject_bad_key",
      "valid": false,
